@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #3B4A5C
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B4A5C
  BorderThickness 1.3
  HeaderBackgroundColor #ECEFF3
  FontStyle bold
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FDFBEA
  BorderColor #B9A64B
  FontSize 11
}
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
}
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
class ControladorSolicitudes {
  +radicar(tipo: String, estudiante: String,
  creditos: int, detalle: String): String
}
class SolicitudHomologacion {
  +procesar(estudiante: String, creditos: int, detalle: String): String
}
class SolicitudCancelacion {
  +procesar(estudiante: String, creditos: int, detalle: String): String
}
class SolicitudSupletorio {
  +procesar(estudiante: String, creditos: int, detalle: String): String
}
class SiaLegado <<legado>> {
  +llamar(codigoOperacion: int, parametros: String): int
}
class Correo {
  +enviar(estudiante: String, msg: String): void
}
ControladorSolicitudes ..> SolicitudHomologacion : new (switch)
ControladorSolicitudes ..> SolicitudCancelacion : new (switch)
ControladorSolicitudes ..> SolicitudSupletorio : new (switch)
SolicitudHomologacion --> SiaLegado
SolicitudCancelacion --> SiaLegado
SolicitudSupletorio --> SiaLegado
SolicitudHomologacion --> Correo
SolicitudCancelacion --> Correo
SolicitudSupletorio --> Correo
@enduml
