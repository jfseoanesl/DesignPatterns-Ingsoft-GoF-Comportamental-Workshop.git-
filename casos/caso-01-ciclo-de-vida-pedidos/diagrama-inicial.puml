@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #3B4A5C
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B4A5C
  BorderThickness 1.3
  HeaderBackgroundColor #ECEFF3
  FontStyle bold
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FDFBEA
  BorderColor #B9A64B
  FontSize 11
}
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
}
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
class Pedido {
  -id: String
  -estado: String
  -items: List<String>
  -total: long
  -cupon: String
  -nota: String
  -regalo: boolean
  -franja: String
  +Pedido(id, cliente, items, total, cupon, nota, regalo, franja)
  +pagar(): void
  +despachar(): void
  +entregar(): void
  +cancelar(): void
}
class Inventario {
  +reservar(items: List<String>): void
  +liberar(items: List<String>): void
}
class Notificador {
  +enviar(cliente: String, msg: String): void
}
class Analitica {
  +registrar(evento: String): void
}
class RapiEnviosApi <<externo>> {
  +crearGuia(payload: String): String
}
Pedido --> Inventario
Pedido --> Notificador
Pedido --> Analitica
Pedido --> RapiEnviosApi
@enduml
